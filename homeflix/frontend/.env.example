# Copier en .env.local pour le développement
VITE_API_BASE=/api
VITE_APP_NAME=Homeflix
# Hôte des microservices pour le proxy de dev Vite (sans port)
VITE_DEV_PROXY_HOST=localhost
# Développer sans backend : API simulée (MSW) à partir des fixtures de docs/api/fixtures.
# Actif uniquement avec `npm run dev`, jamais dans le build de production.
VITE_USE_MOCKS=false
