# Copier vers .env puis remplacer chaque CHANGE_ME (voir scripts/gen-env.sh). Ne jamais committer .env.
POSTGRES_PASSWORD=CHANGE_ME
IDENTITY_DB_PASSWORD=CHANGE_ME
LIBRARY_DB_PASSWORD=CHANGE_ME
ACQUISITION_DB_PASSWORD=CHANGE_ME
# Secret partagé pour les appels /internal entre services
INTERNAL_API_KEY=CHANGE_ME
# Client BitTorrent (Transmission) : accessible uniquement sur le réseau interne
TRANSMISSION_USER=homeflix
TRANSMISSION_PASS=CHANGE_ME
# Dossier de la bibliothèque (monté en lecture seule)
MEDIA_DIR=./demo-media
# Port public du frontend
FRONTEND_PORT=8080
# Ports hôte du profil de développement (compose.dev.yaml), liés à 127.0.0.1
DEV_DB_PORT=15432
DEV_IDENTITY_PORT=18081
DEV_LIBRARY_PORT=18082
DEV_ACQUISITION_PORT=18083
