# ======================================================================================
# Configuration de HomeFlix — modèle de fichier .env
#
# Ne modifiez pas ce fichier pour y mettre vos secrets. Créez votre .env avec :
#     ./scripts/gen-secrets.sh
# Le script génère un secret aléatoire pour chaque variable valant CHANGE_ME ci-dessous,
# crée .env (droits 600) ou complète un .env existant sans jamais modifier ses valeurs.
# .env est ignoré par Git : ne le committez jamais, et ne l'envoyez à personne.
#
# Aucune valeur de ce fichier n'est utilisable telle quelle : CHANGE_ME est refusé comme secret.
# ======================================================================================

# --- Base de données (PostgreSQL) ----------------------------------------------------
# Compte administrateur du serveur PostgreSQL. Utilisé seulement à la création des bases
# (dossier initdb/) ; aucun service HomeFlix ne s'en sert. Secret généré.
POSTGRES_PASSWORD=CHANGE_ME
# Mots de passe des trois comptes SQL, un par service : chacun ne se connecte qu'à sa base.
# Secrets générés. Attention : PostgreSQL ne lit ces mots de passe qu'à la première
# création du volume ; si vous les regénérez, supprimez d'abord le volume (voir plus bas).
IDENTITY_DB_PASSWORD=CHANGE_ME
LIBRARY_DB_PASSWORD=CHANGE_ME
ACQUISITION_DB_PASSWORD=CHANGE_ME

# --- Secrets entre services -----------------------------------------------------------
# Secret partagé des appels internes /internal entre services (en-tête X-Internal-Key).
# Jamais exposé par le proxy. Secret généré.
INTERNAL_API_KEY=CHANGE_ME
# Clé privée RSA qui signe les jetons de connexion (JWT RS256), réservée au service
# Identity. Contenu du fichier PEM (PKCS#8) encodé en base64, sur une seule ligne.
# Les autres services n'ont besoin que de la clé publique, publiée par Identity (JWKS).
# Secret généré.
JWT_PRIVATE_KEY_BASE64=CHANGE_ME
# Secret qui signe les tickets de streaming (lecture vidéo), réservé au service Library.
# Secret généré.
STREAM_TICKET_SECRET=CHANGE_ME
# Jeton à usage unique qui autorise la création du premier administrateur (service
# Identity). À saisir dans l'écran de première configuration. Secret généré.
SETUP_TOKEN=CHANGE_ME

# --- Client BitTorrent (Transmission) -------------------------------------------------
# Identifiants du RPC de Transmission, utilisés par le service Acquisition. Le client n'est
# joignable que sur le réseau interne. Le nom d'utilisateur n'est pas secret.
TRANSMISSION_USER=homeflix
TRANSMISSION_PASS=CHANGE_ME

# --- Bibliothèque et accès ------------------------------------------------------------
# Dossier de votre bibliothèque de films sur la machine hôte. Il est monté en lecture
# seule dans le service Library (chemin du conteneur : /media). Exemple fictif :
MEDIA_DIR=./demo-media
# Port sur lequel HomeFlix est accessible depuis votre machine (http://localhost:8080).
# C'est le seul port publié par la configuration normale.
FRONTEND_PORT=8080

# --- Développement uniquement (compose.dev.yaml) --------------------------------------
# Ports de débogage liés à 127.0.0.1, utiles seulement avec la surcouche de développement.
DEV_DB_PORT=15432
DEV_IDENTITY_PORT=18081
DEV_LIBRARY_PORT=18082
DEV_ACQUISITION_PORT=18083

# --- Si vous regénérez les mots de passe de base de données ---------------------------
# Les volumes existants gardent les anciens mots de passe. Pour repartir de zéro (efface
# comptes, catalogue et progression) :   docker compose down -v
